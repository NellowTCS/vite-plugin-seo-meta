{
  "name": "vite-plugin-seo-meta",
  "version": "0.1.0",
  "description": "Vite plugin for per-page SEO metadata (title, description, canonical, Open Graph, Twitter Cards) with multi-page support.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "seo",
    "meta",
    "open-graph",
    "twitter",
    "canonical",
    "per-page",
    "multi-page"
  ],
  "author": "NellowTCS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NellowTCS/vite-plugin-seo-meta.git"
  },
  "bugs": {
    "url": "https://github.com/NellowTCS/vite-plugin-seo-meta/issues"
  },
  "homepage": "https://github.com/NellowTCS/vite-plugin-seo-meta#readme",
  "peerDependencies": {
    "vite": ">=4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
